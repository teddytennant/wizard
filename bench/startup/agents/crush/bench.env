CMD="crush"
MARKER="> Ready"
VERSION_CMD="crush --version"
BUNDLE='stat -c %s $(readlink -f $(command -v crush))'
ENV="CRUSH_DISABLE_PROVIDER_AUTO_UPDATE=1 CRUSH_DISABLE_METRICS=1"
NOTE="Charm apt repo pinned to crush=0.93.1. OpenAI-type provider on 127.0.0.1:9; Catwalk catalog fetch and metrics off both in crush.json and by environment; project init flag pre-written so the AGENTS.md dialog is skipped. The input placeholder is random (Ready for instructions, Ready..., Ready!), hence the marker."
