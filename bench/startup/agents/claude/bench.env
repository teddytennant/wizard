CMD="claude"
MARKER="❯"
VERSION_CMD="claude --version"
BUNDLE='stat -c %s $(readlink -f $(command -v claude))'
ENV="ANTHROPIC_BASE_URL=http://127.0.0.1:9 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 DISABLE_AUTOUPDATER=1"
NOTE="Native installer pinned to 2.1.268. Onboarding, API-key approval and folder trust pre-answered in ~/.claude.json. Dummy ANTHROPIC_API_KEY with ANTHROPIC_BASE_URL on the dead port; CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 and DISABLE_AUTOUPDATER=1 are its documented switches for the update check, feature flags and remote settings fetch."
