CMD="opencode"
MARKER="Ask anything"
VERSION_CMD="opencode --version"
BUNDLE='stat -c %s $(readlink -f $(command -v opencode))'
ENV="OPENCODE_DISABLE_AUTOUPDATE=1 OPENCODE_DISABLE_MODELS_FETCH=1"
NOTE="opencode.ai/install pinned to 1.18.30. Custom @ai-sdk/openai-compatible provider on 127.0.0.1:9 in opencode.json, autoupdate off there and via OPENCODE_DISABLE_AUTOUPDATE, the models.dev catalog fetch off via OPENCODE_DISABLE_MODELS_FETCH. No telemetry switch is documented."
