CMD="codex"
MARKER="Ask Codex"
VERSION_CMD="codex --version"
BUNDLE='du -sb $(npm root -g)/@openai/codex | cut -f1'
NOTE="npm -g install on NodeSource Node 22; node is counted in the install size, the npm package (with its vendored native binary) as the bundle. Provider on 127.0.0.1:9, /work trusted in config.toml."
