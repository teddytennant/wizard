# Maintainer: Teddy Tennant <teddytennant@icloud.com>
pkgname=wizard-bin
pkgver=2026.11.2
pkgrel=1
pkgdesc="One line. Your sovereign agent. Self-extending. Bring any model"
arch=('x86_64' 'aarch64')
url="https://github.com/teddytennant/wizard"
license=('MIT AND Apache-2.0')
depends=('gcc-libs' 'glibc')
provides=('wizard')
conflicts=('wizard')
options=('!debug' '!strip')
source=("LICENSE-MIT-$pkgver::$url/raw/v$pkgver/LICENSE-MIT")
source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/wizard-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/wizard-aarch64-unknown-linux-gnu.tar.gz")
sha256sums=('74b073d5ef3b24eb791fccbded9fceffb34bc4dabc37fb0a0e2613fc6b705477')
sha256sums_x86_64=('24e418c3aff1f47ef7ca03154b7dc60c2583427ae20d34170708d747855185c5')
sha256sums_aarch64=('58ecc1876350bc85d78d81822cd6d289b26db74fa93343fd7e3f56ec428d6129')

package() {
  install -Dm755 wizard "$pkgdir/usr/bin/wizard"
  # 3.8.2+ tarballs carry the looks. A tarball from before that has none, and
  # bump.sh has not pointed this file at the new release yet.
  for look in wizard-ui-opencode wizard-ui-pi wizard-ui-codex wizard-ui-grok wizard-ui-jcode wizard-ui-claude; do
    if [ -f "$look" ]; then
      install -Dm755 "$look" "$pkgdir/usr/bin/$look"
    fi
  done
  install -Dm644 "LICENSE-MIT-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
}
